{% comment %}
  TJJM State Directory — server-side rendering of every BJJ school in one region.
  >>> READ snippets/tjjm-statedir-notes IN FULL BEFORE TOUCHING THE DATA. <<<
  Every engineering rule, curation trap, per-state removal rationale and the yield model
  now lives there, NOT inline, so this file stays under the Admin API's ~24 KB rewrite
  ceiling. The one rule worth repeating here: gym names must not contain "|", because the
  loop below emits "city|name|website|address" and splits on it.
  Website corrections live in snippets/tjjm-gym-websites (~Name|URL~); an override wins over
  the record's own "w", and an empty value blanks the link entirely.
{% endcomment %}

{{ 'tjjm-core.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tjjm-core.js' | asset_url }}" defer></script>

{%- capture region_index -%}{%- render 'tjjm-region-index' -%}{%- endcapture -%}
{%- assign region_rows = region_index | strip | newline_to_br | split: '<br />' -%}
{%- assign code = '' -%}
{%- assign region = page.title -%}
{%- assign country = 'US' -%}
{%- for r in region_rows limit: 200 -%}
  {%- assign rf = r | strip | split: '|' -%}
  {%- if rf[0] == page.handle -%}
    {%- assign region = rf[1] | strip -%}
    {%- assign code = rf[3] | strip -%}
    {%- assign country = rf[4] | strip -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Newfoundland and Labrador gyms are miscoded "NE" (Nebraska) in the source data.
  They are re-filed here by city so neither region shows the other's schools.
{%- endcomment -%}
{%- assign nl_cities = "St. John's|Corner Brook|Gander|Paradise|Conception Bay South|Labrador City|Grand Falls-Windsor|Clarenville|Mount Pearl|Torbay|Flat Bay" | split: '|' -%}
{%- assign scan_code = code -%}
{%- if code == 'NL' -%}{%- assign scan_code = 'NE' -%}{%- endif -%}

{%- comment -%}
  Legacy records excluded from the listings. The per-state name lists now live in
  snippets/tjjm-removed-index (one row per state code) so this file stays under the
  Admin API's ~24 KB rewrite ceiling. Read that snippet's header before adding a state.
{%- endcomment -%}
{%- capture removed_index -%}{%- render 'tjjm-removed-index' -%}{%- endcapture -%}
{%- assign removed_rows = removed_index | strip | newline_to_br | split: '<br />' -%}
{%- assign removed = '' | split: '|' -%}
{%- for r in removed_rows limit: 100 -%}
  {%- assign rr = r | strip -%}
  {%- if rr == blank -%}{%- continue -%}{%- endif -%}
  {%- assign rc = rr | split: '|' | first -%}
  {%- if rc == scan_code -%}
    {%- assign removed = rr | remove_first: rc | remove_first: '|' | split: '|' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- capture gym_json -%}{%- render 'tjjm-gyms-data' -%}{%- render 'tjjm-gyms-data-2' -%}{%- render 'tjjm-gyms-data-3' -%}{%- render 'tjjm-gyms-data-4' -%}{%- render 'tjjm-gyms-data-5' -%}{%- render 'tjjm-gyms-data-6' -%}{%- render 'tjjm-gyms-data-7' -%}{%- render 'tjjm-gyms-data-8' -%}{%- render 'tjjm-gyms-data-9' -%}{%- render 'tjjm-gyms-data-10' -%}{%- render 'tjjm-gyms-data-11' -%}{%- render 'tjjm-gyms-data-12' -%}{%- render 'tjjm-gyms-data-13' -%}{%- render 'tjjm-gyms-data-14' -%}{%- render 'tjjm-gyms-data-15' -%}{%- render 'tjjm-gyms-data-16' -%}{%- render 'tjjm-gyms-data-17' -%}{%- render 'tjjm-gyms-data-18' -%}{%- render 'tjjm-gyms-data-19' -%}{%- render 'tjjm-gyms-data-20' -%}{%- render 'tjjm-gyms-data-21' -%}{%- render 'tjjm-gyms-data-22' -%}{%- render 'tjjm-gyms-data-23' -%}{%- render 'tjjm-gyms-data-24' -%}{%- render 'tjjm-gyms-data-25' -%}{%- render 'tjjm-gyms-data-26' -%}{%- render 'tjjm-gyms-data-27' -%}{%- render 'tjjm-gyms-data-28' -%}{%- render 'tjjm-gyms-data-29' -%}{%- render 'tjjm-gyms-data-30' -%}{%- render 'tjjm-gyms-data-31' -%}{%- render 'tjjm-gyms-data-32' -%}{%- render 'tjjm-gyms-data-33' -%}{%- render 'tjjm-gyms-data-34' -%}{%- render 'tjjm-gyms-data-35' -%}{%- render 'tjjm-gyms-data-36' -%}{%- render 'tjjm-gyms-data-37' -%}{%- render 'tjjm-gyms-data-38' -%}{%- render 'tjjm-gyms-data-39' -%}{%- render 'tjjm-gyms-data-40' -%}{%- render 'tjjm-gyms-data-41' -%}{%- render 'tjjm-gyms-data-42' -%}{%- render 'tjjm-gyms-data-43' -%}{%- render 'tjjm-gyms-data-44' -%}{%- render 'tjjm-gyms-data-45' -%}{%- render 'tjjm-gyms-data-46' -%}{%- endcapture -%}
{%- capture addr_overrides -%}{%- render 'tjjm-gym-addresses' -%}{%- endcapture -%}
{%- capture city_overrides -%}{%- render 'tjjm-gym-cities' -%}{%- endcapture -%}
{%- capture web_overrides -%}{%- render 'tjjm-gym-websites' -%}{%- render 'tjjm-gym-websites-2' -%}{%- render 'tjjm-gym-websites-3' -%}{%- render 'tjjm-gym-websites-4' -%}{%- render 'tjjm-gym-websites-5' -%}{%- render 'tjjm-gym-websites-6' -%}{%- render 'tjjm-gym-websites-7' -%}{%- endcapture -%}
{%- assign recs = gym_json | split: '{"n":"' -%}
{%- assign needle = '","s":"' | append: scan_code | append: '"' -%}

{%- capture buf -%}
{%- for rec in recs offset: 1 limit: 20000 -%}
  {%- unless rec contains needle -%}{%- continue -%}{%- endunless -%}
  {%- assign a1 = rec | split: '","c":"' -%}
  {%- assign g_name = a1[0] | strip -%}
  {%- if g_name == blank -%}{%- continue -%}{%- endif -%}
  {%- if removed contains g_name -%}{%- continue -%}{%- endif -%}
  {%- assign a2 = a1[1] | split: '","s":"' -%}
  {%- assign g_city = a2[0] | strip -%}
  {%- assign is_nl = false -%}
  {%- if nl_cities contains g_city -%}{%- assign is_nl = true -%}{%- endif -%}
  {%- if scan_code == 'NE' -%}
    {%- if code == 'NL' and is_nl == false -%}{%- continue -%}{%- endif -%}
    {%- if code == 'NE' and is_nl -%}{%- continue -%}{%- endif -%}
  {%- endif -%}
  {%- assign cprobe = '~' | append: g_name | append: '|' -%}
  {%- if city_overrides contains cprobe -%}{%- assign g_city = city_overrides | split: cprobe | last | split: '~' | first | strip -%}{%- endif -%}
  {%- assign g_web = '' -%}
  {%- assign w1 = rec | split: '","w":"' -%}
  {%- if w1.size > 1 -%}{%- assign g_web = w1[1] | split: '"' | first | strip -%}{%- endif -%}
  {%- assign wprobe = '~' | append: g_name | append: '|' -%}
  {%- if web_overrides contains wprobe -%}
    {%- assign g_web = web_overrides | split: wprobe | last | split: '~' | first | strip -%}
  {%- endif -%}
  {%- assign g_addr = '' -%}
  {%- assign d1 = rec | split: '","a":"' -%}
  {%- if d1.size > 1 -%}{%- assign g_addr = d1[1] | split: '"' | first | strip -%}{%- endif -%}
  {%- if g_addr == blank -%}
    {%- assign probe = '~' | append: g_name | append: '|' -%}
    {%- if addr_overrides contains probe -%}
      {%- assign g_addr = addr_overrides | split: probe | last | split: '~' | first | strip -%}
    {%- endif -%}
  {%- endif -%}
  {{ g_city }}|{{ g_name }}|{{ g_web }}|{{ g_addr }}~~
{%- endfor -%}
{%- endcapture -%}

{%- assign list = buf | strip | split: '~~' | sort -%}
{%- assign gym_count = list.size -%}
{%- assign prev_city = '' -%}
{%- capture city_buf -%}
{%- for item in list limit: 2000 -%}
  {%- assign c0 = item | strip | split: '|' | first -%}
  {%- if c0 != prev_city -%}
    {%- assign prev_city = c0 -%}{{ c0 }}~
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign cities = city_buf | strip | split: '~' -%}
{%- assign city_count = cities.size -%}

{%- assign country_name = 'the United States' -%}
{%- if country == 'CA' -%}{%- assign country_name = 'Canada' -%}{%- endif -%}

<section class="tjjm-scope tjjm-sec" data-tjjm-statedir>
  <div class="tjjm-wrap">

    <nav class="tjjm-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><a href="/pages/jiu-jitsu-schools-near-you">Schools Near You</a><span aria-hidden="true">/</span><span aria-current="page">{{ region | escape }}</span>
    </nav>

    <header class="tjjm-reveal" style="position:relative;z-index:2;margin-bottom:30px">
      <div class="tjjm-kicker">The Community</div>
      <h1 class="tjjm-display tjjm-h2">Brazilian Jiu Jitsu Schools in {{ region | escape }}</h1>
      {%- if gym_count > 0 -%}
        <p class="tjjm-p">{{ gym_count }} BJJ gym{% if gym_count != 1 %}s{% endif %} and academies{% if city_count > 0 %} across {{ city_count }} cit{% if city_count == 1 %}y{% else %}ies{% endif %}{% endif %} in {{ region | escape }}, {{ country_name }}. Every school is listed free. Train somewhere that is not here yet? <a href="/pages/jiu-jitsu-schools-near-you#add-gym">Add your gym</a>.</p>
      {%- endif -%}
    </header>

    {%- if gym_count > 0 -%}
      <label class="tjjm-flabel" for="tjjm-q" data-tjjm-tools hidden>Filter by city or gym name</label>
      <div class="tjjm-fbar" data-tjjm-tools hidden>
        <input id="tjjm-q" class="tjjm-finput" type="search" autocomplete="off" spellcheck="false" placeholder="City or gym name">
        <button class="tjjm-fclear" type="button" data-tjjm-clear hidden>Clear</button>
      </div>
      <p class="tjjm-fcount" data-tjjm-tools data-tjjm-count aria-live="polite" aria-atomic="true" hidden>Showing {{ gym_count }} of {{ gym_count }}</p>

      <details class="tjjm-jump"{% if city_count <= 24 %} open{% endif %}>
        <summary class="tjjm-jump-s">Browse by city <em>{{ city_count }}</em></summary>
        <div class="tjjm-jump-b">
          {%- assign prev_l = '' -%}
          {%- for c in cities -%}
            {%- assign cs = c | strip -%}
            {%- if cs == blank -%}{%- continue -%}{%- endif -%}
            {%- assign l = cs | slice: 0 | upcase -%}
            {%- if l != prev_l -%}
              {%- unless prev_l == blank -%}</div>{%- endunless -%}
              {%- assign prev_l = l -%}
              <div class="tjjm-jg"><b class="tjjm-jl" aria-hidden="true">{{ l | escape }}</b>
            {%- endif -%}
            <a class="tjjm-ja" href="#{{ cs | handleize }}">{{ cs | escape }}</a>
          {%- endfor -%}
          {%- unless prev_l == blank -%}</div>{%- endunless -%}
        </div>
      </details>

      <p class="tjjm-p tjjm-nomatch" data-tjjm-none hidden>No schools match that search. <button class="tjjm-fclear" type="button" data-tjjm-clear>Show all {{ gym_count }}</button></p>

      {%- assign current_city = '' -%}
      {%- assign grid_open = false -%}
      {%- for item in list limit: 2000 -%}
        {%- assign f = item | strip | split: '|' -%}
        {%- assign g_city = f[0] | strip -%}
        {%- assign g_name = f[1] | strip -%}
        {%- if g_name == blank -%}{%- continue -%}{%- endif -%}
        {%- assign g_web = f[2] | strip -%}
        {%- assign g_addr = f[3] | strip -%}

        {%- if g_city != current_city -%}
          {%- if grid_open -%}</div>{%- endif -%}
          {%- assign current_city = g_city -%}
          {%- assign grid_open = true -%}
          <h2 class="tjjm-city-h" id="{{ g_city | handleize }}" data-c="{{ g_city | escape }}">Jiu Jitsu in {{ g_city | escape }}{% if code != blank %}, {{ code }}{% endif %}</h2>
          <div class="tjjm-gyms tjjm-reveal">
        {%- endif -%}

        <div class="tjjm-gym">
          <h3>{{ g_name | escape }}</h3>
          {%- if g_addr != blank -%}
            {%- capture mapq -%}{{ g_addr }}, {{ g_city }}, {{ code }}{%- endcapture -%}
            <p class="tjjm-gym-loc"><a class="tjjm-gym-map" href="https://maps.google.com/?q={{ mapq | url_encode }}" target="_blank" rel="noopener">{{ g_addr | escape }}</a></p>
          {%- else -%}
            <p class="tjjm-gym-loc">{{ g_city | escape }}{% if code != blank %}, {{ code }}{% endif %}</p>
          {%- endif -%}
          {%- if g_web != blank -%}
            {%- assign g_href = g_web -%}
            {%- unless g_href contains '://' -%}{%- assign g_href = 'https://' | append: g_web -%}{%- endunless -%}
            <a class="tjjm-gym-site" href="{{ g_href }}" target="_blank" rel="noopener nofollow">Visit Website <span class="tjjm-arr">&rarr;</span></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
      {%- if grid_open -%}</div>{%- endif -%}
    {%- else -%}
      <p class="tjjm-p">No schools listed in {{ region | escape }} yet &mdash; <a href="/pages/jiu-jitsu-schools-near-you#add-gym">yours could be the first</a>.</p>
    {%- endif -%}

    {%- if region_rows.size > 1 -%}
      <div class="tjjm-regions">
        <h2 class="tjjm-city-h">Find schools in another state or province</h2>
        <ul class="tjjm-region-list">
          {%- for r in region_rows limit: 200 -%}
            {%- assign rf = r | strip | split: '|' -%}
            {%- assign r_slug = rf[0] | strip -%}
            {%- if r_slug == blank -%}{%- continue -%}{%- endif -%}
            <li>
              {%- if r_slug == page.handle -%}
                <span class="is-current">{{ rf[1] | strip | escape }} <em>{{ rf[2] | strip }}</em></span>
              {%- else -%}
                <a href="/pages/{{ r_slug }}">{{ rf[1] | strip | escape }} <em>{{ rf[2] | strip }}</em></a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="tjjm-state-cta">
      <p class="tjjm-p">Browse the <a href="/pages/jiu-jitsu-schools-near-you">full directory of every school we list</a>, or start with the <a href="/blogs/encyclopedia">BJJ Encyclopedia</a> if you are brand new to the mats.</p>
    </div>

  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
    { "@type": "ListItem", "position": 2, "name": "Schools Near You", "item": {{ request.origin | append: '/pages/jiu-jitsu-schools-near-you' | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ region | json }}, "item": {{ request.origin | append: page.url | json }} }
  ]
}
</script>

{%- if gym_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ 'Brazilian Jiu Jitsu schools in ' | append: region | json }},
  "numberOfItems": {{ gym_count }},
  "itemListElement": [
{%- assign printed = 0 -%}
{%- for item in list limit: 2000 -%}
{%- assign f = item | strip | split: '|' -%}
{%- assign g_city = f[0] | strip -%}
{%- assign g_name = f[1] | strip -%}
{%- if g_name == blank -%}{%- continue -%}{%- endif -%}
{%- assign g_web = f[2] | strip -%}
{%- assign g_addr = f[3] | strip -%}
{%- if printed > 0 %},{% endif -%}
{%- assign printed = printed | plus: 1 -%}
{ "@type": "ListItem", "position": {{ printed }}, "item": { "@type": "SportsActivityLocation", "name": {{ g_name | json }}, "sport": "Brazilian Jiu-Jitsu", "address": { "@type": "PostalAddress"{% if g_addr != blank %}, "streetAddress": {{ g_addr | json }}{% endif %}, "addressLocality": {{ g_city | json }}, "addressRegion": {{ code | json }}, "addressCountry": {{ country | json }} }{%- if g_web != blank -%}{%- assign g_href = g_web -%}{%- unless g_href contains '://' -%}{%- assign g_href = 'https://' | append: g_web -%}{%- endunless -%}, "url": {{ g_href | json }}{%- endif -%} } }
{%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- render 'tjjm-statedir-css' -%}

<style>
section[data-tjjm-statedir]{overflow:clip}
section[data-tjjm-statedir] [hidden]{display:none!important}
.tjjm-flabel{display:block;position:relative;z-index:2;font-size:.75rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--dim);margin-bottom:8px}
.tjjm-fbar{position:sticky;top:0;z-index:6;display:flex;gap:8px;background:var(--ink);padding:10px 0;border-bottom:1px solid var(--line)}
.tjjm-finput{flex:1;min-width:0;min-height:44px;padding:10px 14px;background:var(--panel);border:1px solid var(--line);color:var(--bone);font-family:'Inter',sans-serif;font-size:1rem;appearance:none;-webkit-appearance:none}
.tjjm-finput::placeholder{color:var(--dim);opacity:.7}
.tjjm-finput:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.tjjm-fclear{min-height:44px;padding:10px 16px;background:none;border:1px solid var(--line);color:var(--dim);font-family:'Anton',sans-serif;font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.tjjm-fclear:hover{color:var(--bone);border-color:var(--red)}
.tjjm-fclear:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.tjjm-fcount{position:relative;z-index:2;margin:8px 0 22px;font-size:.85rem;letter-spacing:.06em;color:var(--dim)}
.tjjm-jump{position:relative;z-index:2;border:1px solid var(--line);background:var(--panel);margin:0 0 26px}
.tjjm-jump-s{display:flex;align-items:center;gap:10px;min-height:44px;padding:12px 16px;font-family:'Anton',sans-serif;font-size:.95rem;letter-spacing:.12em;text-transform:uppercase;color:var(--bone);cursor:pointer;list-style:none}
.tjjm-jump-s::-webkit-details-marker{display:none}
.tjjm-jump-s::after{content:"+";margin-left:auto;color:var(--red);font-size:1.25rem;line-height:1}
.tjjm-jump[open] .tjjm-jump-s::after{content:"\2212"}
.tjjm-jump-s:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.tjjm-jump-s em{font-style:normal;color:var(--dim);font-size:.85em}
.tjjm-jump-b{padding:2px 16px 12px;border-top:1px solid var(--line)}
.tjjm-jg{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 16px;padding:6px 0;border-bottom:1px solid var(--line)}
.tjjm-jg:last-child{border-bottom:0}
.tjjm-jl{font-family:'Anton',sans-serif;font-weight:400;font-size:.95rem;color:var(--red);flex:none;width:1.5em}
.tjjm-ja{display:inline-block;min-height:40px;padding:7px 0;line-height:26px;font-size:.93rem;color:var(--dim);text-decoration:none}
.tjjm-ja:hover{color:var(--red)}
.tjjm-ja:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.tjjm-ja.is-off{opacity:.3;pointer-events:none}
.tjjm-city-h{scroll-margin-top:84px}
.tjjm-nomatch{margin:26px 0 40px}
section[data-tjjm-statedir].is-filtering .tjjm-reveal{opacity:1;transform:none;transition:none}
html.no-js .tjjm-reveal{opacity:1;transform:none}
@media(max-width:620px){.tjjm-jump-b{padding:2px 12px 10px}.tjjm-jg{gap:0 13px}}
</style>

{%- if gym_count > 0 -%}
<script>
(function(){
var root=document.querySelector('[data-tjjm-statedir]');if(!root)return;
var q=root.querySelector('#tjjm-q');if(!q)return;
var countEl=root.querySelector('[data-tjjm-count]'),noneEl=root.querySelector('[data-tjjm-none]');
function norm(s){s=(s||'').toLowerCase();try{s=s.normalize('NFD').replace(/[\u0300-\u036f]/g,'')}catch(e){}return s}
var groups=[],byId={},total=0;
[].forEach.call(root.querySelectorAll('h2.tjjm-city-h[id]'),function(h){
  var grid=h.nextElementSibling,city=norm(h.getAttribute('data-c')),items=[];
  if(!grid||grid.className.indexOf('tjjm-gyms')<0)return;
  [].forEach.call(grid.querySelectorAll('.tjjm-gym'),function(el){
    var n=el.querySelector('h3');items.push({el:el,hay:city+' '+norm(n?n.textContent:'')});total++;});
  var g={h:h,grid:grid,items:items};groups.push(g);byId[h.id]=g;});
var jumps=[].slice.call(root.querySelectorAll('.tjjm-ja'));
var clears=[].slice.call(root.querySelectorAll('[data-tjjm-clear]'));
function apply(){
  var v=norm(q.value.trim()),shown=0,i,j,g,it,m,hide;
  root.classList.toggle('is-filtering',!!v);
  for(i=0;i<groups.length;i++){g=groups[i];var vis=0;
    for(j=0;j<g.items.length;j++){it=g.items[j];m=!v||it.hay.indexOf(v)>-1;
      if(it.el.hidden===m)it.el.hidden=!m;if(m)vis++;}
    hide=!!v&&vis===0;
    if(g.h.hidden!==hide){g.h.hidden=hide;g.grid.hidden=hide;}
    shown+=vis;}
  for(i=0;i<jumps.length;i++){g=byId[decodeURIComponent(jumps[i].getAttribute('href').slice(1))];
    if(g)jumps[i].classList.toggle('is-off',!!g.h.hidden);}
  countEl.textContent='Showing '+shown+' of '+total;
  noneEl.hidden=shown>0;
  clears[0].hidden=!v;
}
for(var k=0;k<clears.length;k++)clears[k].addEventListener('click',function(){q.value='';apply();q.focus();});
q.addEventListener('input',apply);
q.addEventListener('keydown',function(e){if(e.key==='Escape'&&q.value){q.value='';apply();}});
[].forEach.call(root.querySelectorAll('[data-tjjm-tools]'),function(e){e.hidden=false});
countEl.textContent='Showing '+total+' of '+total;
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "TJJM State Directory",
  "tag": "section",
  "settings": [],
  "presets": [{ "name": "TJJM State Directory" }]
}
{% endschema %}
